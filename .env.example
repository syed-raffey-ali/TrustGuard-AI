# ============================================================
# TrustGuard AI — backend environment (Bible Section 18 template)
# Copy to .env and fill in what you have. EVERY cloud key is
# optional: with all keys empty the system runs fully local.
# ============================================================

# ---- Local Tier-2 model (Ollama, offline fallback) ----
LOCAL_ENABLED=1
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL_NAME=qwen2.5:3b-instruct
LOCAL_MODEL_ENDPOINT=http://localhost:11434

# ---- Cloud Tier-2 providers (OpenAI-compatible) ----
# Bible default sponsor endpoint:
CLOUD_MODEL_PROVIDER=alibaba_model_studio
CLOUD_MODEL_NAME=qwen-plus
ALIBABA_API_KEY=

# Additional race participants — any/all are optional:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Which result drives the LIVE banner: local | cloud (Bible Section 9.1)
PRIMARY_MODEL=cloud
# Optional: force a specific cloud provider as primary (name from registry).
# Empty = lowest-priority-number provider that has a key.
PRIMARY_CLOUD_PROVIDER=

# ---- STT ----
STT_MODEL=small          # small on CPU, medium/large-v3 on GPU

# ---- Storage ----
DATABASE_URL=postgresql+asyncpg://trustguard:trustguard@db:5432/trustguard
REDIS_URL=redis://redis:6379/0

# Never commit a real key. Keys live here or via the Providers admin API,
# persisted to data/providers.json (gitignored).
